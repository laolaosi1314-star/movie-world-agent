# ============================================================================
# 影视世界 Agent —— LLM Provider 配置示例（复制为 .env 后填写，切勿提交真实密钥）
# ----------------------------------------------------------------------------
# 本文件仅作为模板。新建同名 .env 写入真实值即可被 app 自动读取（仅读取 LLM_* 变量）。
# 未配置 / 未启用时，表达层自动降级到规则模板，世界演化不受影响。
#
# Provider 兼容任意 OpenAI /chat/completions 接口：
#   OpenAI        base_url=https://api.openai.com/v1
#   DeepSeek      base_url=https://api.deepseek.com/v1
#   Moonshot      base_url=https://api.moonshot.cn/v1
#   智谱 GLM      base_url=https://open.bigmodel.cn/api/paas/v4
#   本地 vLLM     base_url=http://localhost:8000/v1
#   Ollama(shim)  base_url=http://localhost:11434/v1
# ============================================================================

# 是否启用真实 LLM（true/false）。不填或 false -> 全程模板，无网络请求。
LLM_ENABLED=false

# 一键切回模板：设为 true 后即使 LLM_ENABLED=true 也强制用模板（调试/降级开关）。
LLM_FORCE_TEMPLATE=false

# Provider 标识（仅用于诊断展示，不影响接口调用）。
LLM_PROVIDER=openai

# OpenAI 兼容的 base_url（末尾的 /v1 按提供方要求）。
LLM_BASE_URL=https://api.openai.com/v1

# API Key（真实值写在 .env，切勿提交到仓库）。
LLM_API_KEY=

# 模型名（按提供方可用模型填写，如 gpt-4o-mini / deepseek-chat / moonshot-v1-8k 等）。
LLM_MODEL=gpt-4o-mini

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=300
LLM_TOP_P=0.9

# 超时（秒）与重试次数（仅 5xx 时重试，4xx/网络错误直接降级模板）。
LLM_TIMEOUT=20
LLM_MAX_RETRIES=1
